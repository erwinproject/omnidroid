# Server & Network Ports (all unique > 10000)
API_PORT=13000
WEB_PORT=18080
VITE_PORT=15173

# Dynamic Redroid Host ADB Port Range (used only when exposeAdbPort=true)
ADB_PORT_MIN=15555
ADB_PORT_MAX=19999

# Security
NODE_ENV=development
API_KEY=change-me-super-secret-api-key
REQUIRE_AUTH=false

# Docker & Redroid
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=emulator-net
REDROID_IMAGE_REPO=redroid/redroid
REDROID_PLAYSTORE_IMAGE_REPO=droidforge/redroid
PROXY_RELAY_HOST=
PROXY_RELAY_PORT_MIN=24000
PROXY_RELAY_PORT_MAX=24999
DATA_DIR=./data
ADB_BIN=adb

# Auto-prune orphaned Docker/disk artifacts when deleting an Android instance
AUTO_PRUNE_ON_DELETE=true
PRUNE_DANGLING_IMAGES_ON_DELETE=true
